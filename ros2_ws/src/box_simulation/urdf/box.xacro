<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="box">

  <xacro:arg name="name_space" default="robot1"/>
  <xacro:property name="name_space" value="$(arg name_space)"/>

  <!-- Box v2 (2026-10 CAD: THAN / CANHTRAI / CANHPHAI). Meshes and every
       number below come from scripts/make_box_meshes.py; re-run it and copy
       its output here if the CAD changes.

       Model frame: Z UP, origin on the ground under the centre of the body,
       metres. (The old box was modelled Y-up and spawned with roll = pi/2;
       this one spawns with roll = 0.) The landing surface (top plate) is at
       z = 0.721, centred on x = y = 0.

       Joint names, ranges and directions are unchanged, so
       box_hardware_adapter / box_manager need no change:
         lid_*_joint   0 (closed) .. 1.57 (open), lids swing OUTWARD about Y
         clamp_*_joint 0 (open) .. 0.2 (closed), bars move INWARD -->
  <joint name="clamp_h_1_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="clamp_h_1_link"/>
    <axis xyz="0.00000 1.00000 0.00000"/>
    <limit effort="1000.0" lower="0" upper="0.2" velocity="2.0"/>
    <origin rpy="0.00000 0.00000 0.00000" xyz="0.00045 -0.45213 0.75646"/>
  </joint>
  <joint name="clamp_h_2_joint" type="prismatic">
    <mimic joint="clamp_h_1_joint"/>
    <parent link="base_link"/>
    <child link="clamp_h_2_link"/>
    <axis xyz="0.00000 -1.00000 0.00000"/>
    <limit effort="1000.0" lower="0" upper="0.2" velocity="2.0"/>
    <origin rpy="0.00000 0.00000 0.00000" xyz="0.00045 0.47188 0.73446"/>
  </joint>
  <joint name="clamp_v_1_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="clamp_v_1_link"/>
    <axis xyz="1.00000 0.00000 0.00000"/>
    <limit effort="100.0" lower="0" upper="0.2" velocity="2.0"/>
    <origin rpy="0.00000 0.00000 0.00000" xyz="-0.48072 -0.00040 0.72921"/>
  </joint>
  <joint name="clamp_v_2_joint" type="prismatic">
    <mimic joint="clamp_v_1_joint"/>
    <parent link="base_link"/>
    <child link="clamp_v_2_link"/>
    <axis xyz="-1.00000 0.00000 0.00000"/>
    <limit effort="100.0" lower="0" upper="0.2" velocity="2.0"/>
    <origin rpy="0.00000 0.00000 0.00000" xyz="0.48162 -0.00040 0.72921"/>
  </joint>
  <!-- GPS antenna puck on the back edge of the body (part of base.stl) -->
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.60900 0.67100"/>
  </joint>
  <!-- Hinges on the brackets at the bottom of the body side walls. ASSUMED:
       the CAD export has no assembly placement, see make_box_meshes.py. -->
  <joint name="lid_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="lid_left_link"/>
    <axis xyz="0.00000 -1.00000 0.00000"/>
    <limit effort="100000.0" lower="0" upper="1.57" velocity="1.00000"/>
    <origin rpy="0.00000 0.00000 0.00000" xyz="-0.53000 0.00000 0.25300"/>
  </joint>
  <joint name="lid_right_joint" type="revolute">
    <mimic joint="lid_left_joint"/>
    <parent link="base_link"/>
    <child link="lid_right_link"/>
    <axis xyz="0.00000 1.00000 0.00000"/>
    <limit effort="100000.00" lower="0" upper="1.57" velocity="1.00000"/>
    <origin rpy="0.00000 0.00000 0.00000" xyz="0.53000 0.00000 0.25300"/>
  </joint>
  <link name="base_link">
    <!-- legs + bottom frame -->
    <collision name="base_collision">
      <origin xyz="0.00000 -0.03450 0.11500" rpy="0 0 0"/>
      <geometry>
        <box size="0.94700 1.03900 0.23000"/>
      </geometry>
    </collision>
    <!-- body -->
    <collision name="base_collision.000">
      <origin xyz="0.00000 -0.00700 0.44750" rpy="0 0 0"/>
      <geometry>
        <box size="1.00000 0.98600 0.43500"/>
      </geometry>
    </collision>
    <!-- top plate = landing surface, top face at z = 0.721 -->
    <collision name="base_collision.001">
      <origin xyz="0.00000 0.00000 0.69300" rpy="0 0 0"/>
      <geometry>
        <box size="0.95000 0.97000 0.05600"/>
      </geometry>
      <surface>
        <contact/>
      </surface>
    </collision>
    <inertial>
      <inertia ixx="5" ixy="0" ixz="0" iyy="5" iyz="0" izz="5"/>
      <origin rpy="0 0 0" xyz="0 0 0.35"/>
      <mass value="20.00000"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://box_simulation/meshes/stl/base.stl"/>
      </geometry>
    </visual>
  </link>
  <link name="clamp_h_1_link">
    <collision name="clamp_h_1_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.28200 0.09200 0.07050"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.50000"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://box_simulation/meshes/stl/clamp_h_1.stl"/>
      </geometry>
    </visual>
  </link>
  <link name="clamp_h_2_link">
    <collision name="clamp_h_2_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.28200 0.09519 0.02650"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.50000"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://box_simulation/meshes/stl/clamp_h_2.stl"/>
      </geometry>
    </visual>
  </link>
  <link name="clamp_v_1_link">
    <collision name="clamp_v_1_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.08800 0.70000 0.01600"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.50000"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://box_simulation/meshes/stl/clamp_v_1.stl"/>
      </geometry>
    </visual>
  </link>
  <link name="clamp_v_2_link">
    <collision name="clamp_v_2_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.08800 0.70000 0.01600"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.50000"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://box_simulation/meshes/stl/clamp_v_2.stl"/>
      </geometry>
    </visual>
  </link>
  <link name="gps_link">
    <inertial>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.0100"/>
    </inertial>
  </link>
  <link name="lid_left_link">
    <inertial>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.00000"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://box_simulation/meshes/stl/lid_left.stl"/>
      </geometry>
      <material name="Gazebo/Orange"/>
    </visual>
  </link>
  <link name="lid_right_link">
    <inertial>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.00000"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://box_simulation/meshes/stl/lid_right.stl"/>
      </geometry>
      <material name="Gazebo/Blue"/>
    </visual>
  </link>
  <gazebo reference="lid_left_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="lid_right_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="base_link">
    <material>Gazebo/White</material>

    <!-- M3.5: the fractal ArUco marker is NOT here. It is its own SDF model,
         Tools/simulation/gz/models/dib_box_marker, spawned onto this box by
         box_spawn_only.launch.py at a pose derived from the box spawn pose.

         A <visual> was tried here first and FAILED SILENTLY. sdformat's URDF
         parser does not turn a <visual> inside <gazebo reference="..."> into a
         visual of its own; it strips the wrapper and merges the children into
         the link's existing base_link_visual, which then carries two <pose>
         and two <geometry> elements. The first of each wins, so the marker
         plane was discarded with no error and no warning; the box rendered
         normally and the landing surface was simply blank.

         Proof, should anyone be tempted to try again: the xacro output
         contains landing_marker_visual once, and `gz sdf -p` output contains
         it zero times. URDF also has no <plane> geometry and no PBR
         albedo_map, so this marker cannot be expressed here at all. -->
  </gazebo>
  <gazebo reference="clamp_v_1_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="clamp_v_2_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="clamp_h_1_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="clamp_h_2_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="gps_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <!-- Gazebo Harmonic (gz-sim8) uses gz_ros2_control; the ign_ros2_control
           name is for the older Ignition Fortress and fails to load here
           (missing GzPluginHook). -->
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="clamp_h_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="clamp_h_2_joint">
      <param name="mimic">clamp_h_1_joint</param>
      <param name="multiplier">1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="clamp_v_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="clamp_v_2_joint">
      <param name="mimic">clamp_v_1_joint</param>
      <param name="multiplier">1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="lid_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="lid_right_joint">
      <param name="mimic">lid_left_joint</param>
      <param name="multiplier">1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <!-- Gazebo Harmonic (gz-sim8) plugin name; was ign_ros2_control-system
         (Ignition Fortress) which does not load under Harmonic. -->
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find box_simulation)/config/box_controller.yaml</parameters>
    </plugin>
  </gazebo>
  <gazebo reference="gps_link">
    <sensor name="my_gps" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>${name_space}/gps/fix</topic>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>
</robot>
