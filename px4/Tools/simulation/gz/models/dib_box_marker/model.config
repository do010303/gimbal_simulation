<?xml version="1.0"?>
<model>
  <name>dib_box_marker</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>dib</name>
  </author>
  <description>
    FRACTAL_5L_6 marker sized for the drone-in-a-box landing surface: the plane
    is 0.6241 m so that the BLACK marker inside it measures exactly 0.50 m,
    matching offboard_precland_params.yaml's marker_size. Spawned onto the
    box_simulation model by box_spawn_only.launch.py.
  </description>
</model>
