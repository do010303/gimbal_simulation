# ROS 2 workspace build artifacts
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
build/
install/
log/
real_camera_tracker/ros2_ws/
flight_tests/
search_frame.png
scratch/

# External dependencies (clone separately)
ros2_ws/src/px4_msgs/

# ArUco C++ library: ship only the 1.6 MB source zip; the 16 MB extracted tree
# and any build output are regenerated by verify_build_env.sh, keep them out.
aruco_build/*
!aruco_build/aruco.zip

# box_simulation base visual is shipped gzipped (BOX PAD1.0_simple.dae.gz, 64 MB)
# because the raw .dae is 270 MB (> GitHub's 100 MB limit). verify_build_env.sh
# gunzips it before the build; keep the decompressed copies out of git.
ros2_ws/src/box_simulation/meshes/dae/BOX PAD1.0_simple.dae
ros2_ws/src/box_simulation/meshes/dae/base_link_1.dae

# Keep local project documents private; publish only the approved files.
docs/*
!docs/marker.png
!docs/FLIGHT_TEST.md
!docs/fractal_aruco_fsm.dot
!docs/fractal_aruco_fsm.png
# M3 deliverable: consolidated doc + its test harness (see docs/m3.md).
!docs/m3.md
!docs/m3_box_handshake_test/
!docs/m3_box_handshake_test/*.py
!docs/m3_box_handshake_test/*.md

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
